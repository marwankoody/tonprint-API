# Modèle de configuration pour le déploiement en production sur tonprint.ma
# Copier ces valeurs dans le .env du serveur de production (jamais commiter le vrai .env)

# Server
PORT=5000
NODE_ENV=production

# MongoDB — cluster de production (Atlas ou VM dédiée)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tonprint?retryWrites=true&w=majority

# JWT — générer des secrets forts (ex: `openssl rand -base64 48`), jamais réutiliser ceux de dev
JWT_ACCESS_SECRET=__generate_a_strong_secret__
JWT_REFRESH_SECRET=__generate_a_strong_secret__
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — le site officiel tourne sur tonprint.ma (avec et sans www)
CORS_ORIGINS=https://www.tonprint.ma,https://tonprint.ma

# URL canonique du site
FRONTEND_URL=https://www.tonprint.ma

# Cookie de refresh token partagé entre www.tonprint.ma et tonprint.ma
COOKIE_DOMAIN=.tonprint.ma

# Cloudinary — stockage images produits
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form → Google Sheets (Apps Script web app URL + secret partagé)
CONTACT_SHEETS_WEBHOOK_URL=
CONTACT_SHEETS_SECRET=
