# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tonprint

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — origines autorisées, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# URL canonique du site officiel (liens emails, redirections)
FRONTEND_URL=https://www.tonprint.ma

# Domaine du cookie de refresh token — vide en local, ".tonprint.ma" en production
COOKIE_DOMAIN=

# Cloudinary — stockage images produits (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Voir .env.production.example pour les valeurs à utiliser sur le domaine tonprint.ma
