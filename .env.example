# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tonprint

# JWT (min 32 chars each, must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

# Canonical frontend URL used in email links (reset password, etc.)
# Local:  http://localhost:5173
# Prod:   https://www.tonprint.ma
FRONTEND_URL=http://localhost:5173

# Refresh cookie domain — empty in local, ".tonprint.ma" in production
COOKIE_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact → Google Sheets
CONTACT_SHEETS_WEBHOOK_URL=
CONTACT_SHEETS_SECRET=

# Gmail SMTP — transactional email (password reset)
# 1. Enable 2FA on the Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Leave GMAIL_APP_PASSWORD empty in local to skip send and log the reset URL
GMAIL_USER=tonprint.officiel@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM=TonPrint <tonprint.officiel@gmail.com>
