# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tonprint

# JWT (min 32 chars each, must differ)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173

COOKIE_DOMAIN=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact → Google Sheets
CONTACT_SHEETS_WEBHOOK_URL=
CONTACT_SHEETS_SECRET=

# Gmail SMTP — required in production (password reset OTP)
# https://myaccount.google.com/apppasswords (2FA required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
